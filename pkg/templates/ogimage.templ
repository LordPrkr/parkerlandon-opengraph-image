package templates

type OGImageParams struct {
	Title     string
	Subtitle  string
	Handle    string
	AvatarURL string
}

templ OGImage(params OGImageParams) {
	<!DOCTYPE html>
	<html>
		<head>
			<meta charset="UTF-8"/>
			<style>
				* {
					margin: 0;
					padding: 0;
					box-sizing: border-box;

					--color-accent: rgb(182, 38, 165);
					--color-text-header: rgb(9, 9, 11);
					--color-text-body: rgb(113, 113, 122);
				}
				body {
					width: 1200px;
					height: 630px;
					background: white;
					font-family: "Noto Serif", serif;
					display: flex;
					flex-direction: column;
				}
				.border-bar {
					height: 36px;
					background: var(--color-accent);
				}
				.content {
					flex: 1;
					display: flex;
					align-items: center;
					padding: 40px 60px;
				}
				.avatar-container {
					width: 33%;
					display: flex;
					justify-content: center;
					align-items: center;
				}
				.avatar {
					max-width: 400px;
					object-fit: contain;
				}
				.text-container {
					flex: 1;
					padding-left: 40px;
					display: flex;
					flex-direction: column;
					justify-content: center;
				}
				.title {
					font-family: "Noto Serif", serif;
					font-size: 56px;
					font-weight: 400;
					color: var(--color-text-header);
					line-height: 1.2;
					margin-bottom: 20px;
				}
				.subtitle {
					font-family: "Noto Serif", serif;
					font-size: 32px;
					font-weight: 300;
					color: var(--color-text-body);
					line-height: 1.3;
					margin-bottom: 24px;
				}
				.handle {
					font-size: 28px;
					color: #9ca3af;
				}
			</style>
		</head>
		<body>
			<div class="border-bar"></div>
			<div class="content">
				<div class="avatar-container">
					<img class="avatar" src={ params.AvatarURL } alt="Avatar"/>
				</div>
				<div class="text-container">
					<h1 class="title">{ params.Title }</h1>
					if params.Subtitle != "" {
						<p class="subtitle">{ params.Subtitle }</p>
					}
					<p class="handle">{ params.Handle }</p>
				</div>
			</div>
			<div class="border-bar"></div>
		</body>
	</html>
}
